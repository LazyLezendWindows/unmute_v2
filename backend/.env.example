NODE_ENV=development
PORT=5000
MIN_AGE=18

# Reverse-proxy hops in front of the API (e.g. 1 behind a single load balancer); 0 when exposed directly
TRUST_PROXY=0

# Comma-separated browser origins allowed to call the API with credentials (required in production)
CORS_ORIGIN=http://localhost:5173

# Google Sign-In — OAuth 2.0 Web Client ID from Google Cloud Console:
#   1. Go to APIs & Services → OAuth consent screen and configure your app name & support email.
#   2. Go to APIs & Services → Credentials → Create Credentials → OAuth client ID → Web application.
#   3. Under "Authorized JavaScript origins", add both http://localhost and http://localhost:5173
#      for local development, plus your production frontend origin (e.g. https://your-app.onrender.com).
#   4. "Authorized redirect URIs" can be left empty for GIS popup mode (or set to your frontend origin).
#   5. Copy the Client ID (*.apps.googleusercontent.com) here. The frontend fetches it from
#      /api/v1/auth/config and the backend verifies Google ID tokens against it. No client secret is needed.
GOOGLE_CLIENT_ID=

# Calls (WebRTC). STUN is free and set by default. For calls to connect on strict mobile networks
# and offices, also run or rent a TURN server (e.g. coturn, Twilio, Metered) and fill these in.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Account emails (email verification and "Forgot password" codes). "console" (the default outside
# production) prints them to the server log; production needs an SMTP service (Gmail, Zoho, Amazon
# SES, Brevo…), otherwise those features are off.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Unmute <no-reply@example.com>"

# Admin panel (/admin): admins are separate accounts. With none yet, /admin offers to create the
# first one (outside development it asks for a setup code printed in the server log). Or run
#   npm --prefix backend run admin:create -- admin@example.com "Your Name"
# Selfies and ID photos awaiting review are kept in PRIVATE_UPLOAD_DIR, never served publicly,
# and deleted once reviewed.
PRIVATE_UPLOAD_DIR=

# Phone sign-in codes are sent by SMS. "console" (the default outside production) prints each code
# to the server log instead of sending it; production needs a real provider, otherwise phone
# sign-in is switched off. Supported: console, twilio.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio sender number in E.164 form, e.g. +15005550006
TWILIO_FROM=

# Server-side session lifetime (HttpOnly cookie)
SESSION_TTL_DAYS=30

# Authenticator-app (TOTP) 2FA: encrypts TOTP secrets at rest in MariaDB (AES-256-GCM).
# Generate a 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Unmute

# "lax" for the web app. For the Capacitor apps use "none" (HTTPS only) and add their origins to
# CORS_ORIGIN: https://localhost (Android) and capacitor://localhost (iOS).
SESSION_COOKIE_SAMESITE=lax

# MariaDB Configuration
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=unmute_db
MARIADB_SOCKET=

# One-time membership payments. Keep secrets on the backend only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Web Push (calls ringing and new messages while the app is closed). In development a key pair is
# made automatically and kept in data/vapid.json. For production generate one pair, keep it forever
# (changing it breaks existing subscriptions): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# Request limits. Defaults: sign-in 50 per 15 minutes and SMS codes 10 per hour (per IP); the API 300 per minute
# per signed-in session (per IP for visitors), with a 2000 per minute ceiling per IP address.
# AUTH_RATE_LIMIT=
# SMS_RATE_LIMIT=
# API_RATE_LIMIT=
# API_IP_RATE_LIMIT=

# Public address of the app, used for links in emails (e.g. https://unmute.app).
APP_URL=

# GIFs in chat (free key: developers.giphy.com). Without it the GIF button is hidden.
GIPHY_API_KEY=

# Automatic photo checks (sightengine.com). With both set, nude or sexual photos are refused at upload.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
