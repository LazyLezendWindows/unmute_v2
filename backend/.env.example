NODE_ENV=development
PORT=5000
MIN_AGE=18

# Reverse-proxy hops in front of the API (e.g. 1 behind a single load balancer); 0 when exposed directly
TRUST_PROXY=0

# Comma-separated browser origins allowed to call the API with credentials (required in production)
CORS_ORIGIN=http://localhost:5173

# OAuth 2.0 Web client ID from Google Cloud Console (Credentials → OAuth client ID → Web application,
# with http://localhost:5173 under Authorized JavaScript origins). The frontend fetches it from
# /api/v1/auth/config; ID tokens are verified against it. Google sign-in is disabled when empty.
GOOGLE_CLIENT_ID=

# Calls (WebRTC). STUN is free and set by default. For calls to connect on strict mobile networks
# and offices, also run or rent a TURN server (e.g. coturn, Twilio, Metered) and fill these in.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Phone sign-in codes are sent by SMS. "console" (the default outside production) prints each code
# to the server log instead of sending it; production needs a real provider, otherwise phone
# sign-in is switched off. Supported: console, twilio.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio sender number in E.164 form, e.g. +15005550006
TWILIO_FROM=

# Server-side session lifetime (HttpOnly cookie)
SESSION_TTL_DAYS=30

# "lax" for the web app. For the Capacitor apps use "none" (HTTPS only) and add their origins to
# CORS_ORIGIN: https://localhost (Android) and capacitor://localhost (iOS).
SESSION_COOKIE_SAMESITE=lax

# Development only: seed demo accounts into an empty database (ignored in production)
SEED_DEMO_USERS=false

# MariaDB Configuration
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=unmute_db
MARIADB_SOCKET=
