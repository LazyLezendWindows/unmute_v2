# Optional: normally the Google OAuth 2.0 Web Client ID comes from the backend (GOOGLE_CLIENT_ID via
# /api/v1/auth/config). Set VITE_GOOGLE_CLIENT_ID only if you want to embed it at build time; it must
# match the backend's GOOGLE_CLIENT_ID and have your frontend origin in Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# API base URL; defaults to /api/v1 (proxied to the backend by Vite in development).
# Native (Capacitor) builds must use an absolute HTTPS URL, e.g. https://api.example.com/api/v1;
# Socket.IO connects to the same origin.
VITE_API_URL=

# Operator details shown in the Terms of Service and Privacy Policy (/terms, /privacy).
# VITE_LEGAL_ENTITY=Your Company Private Limited
# VITE_LEGAL_ADDRESS=Registered office address, City, State, PIN
# VITE_SUPPORT_EMAIL=support@yourdomain.com

# Android/iOS builds don't sell plans (store rules). Set to "razorpay" only if your store listing
# allows outside payments (e.g. enrolled in Google Play user choice billing in India).
# VITE_NATIVE_PURCHASES=
